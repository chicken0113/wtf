  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EverythingGrows.NpcManager
  startingGold: 100
  npcs:
  - id: town_guide
    displayName: Mira - Village guide
    shopEnabled: 0
    greeting: The farm is to the west, and the dungeon road heads north. The general
      store and houses are southwest of the square. Welcome to the guild!
    offers: []
  - id: town_smith
    displayName: Rowan - Smith
    shopEnabled: 0
    greeting: Heading into the ruins? Bring something to defend yourself with. The
      entrance is a safe place to catch your breath.
    offers: []
  - id: town_resident
    displayName: June - Resident
    shopEnabled: 0
    greeting: I like seeing what people bring back from their farms. There is always
      something surprising growing out there.
    offers: []
